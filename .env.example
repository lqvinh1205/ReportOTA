# Server Configuration
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# OTA API Configuration
OTA_EMAIL=your_ota_email@example.com
OTA_PASSWORD=your_password_here
OTA_BASE_URL=https://id.bluejaypms.com
# Chỉ đặt khi IP server bị Cloudflare của OTA chặn 403 ("Sorry, you have been blocked").
# Request tới host OTA sẽ đi qua proxy này; các call khác vẫn đi trực tiếp.
OTA_PROXY=http://user:pass@ip_proxy:port

# CORS Configuration
CORS_ORIGINS=all

# Authentication Configuration
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRES_IN=24h

API_BASE_URL=http://localhost:3001

# Booking Monitor
MONITOR_INTERVAL_MS=180000

# ===== OTA Session Cache & Login Lock =====
# Vì sao cần: code cũ login lại từ đầu ở mọi request → 600 lượt login/giờ từ
# một IP và Cloudflare của OTA đã chặn cứng IP server. Session được cache theo
# TÀI KHOẢN (email + hotelId), lưu ở config/sessions.json (tự tạo).
# facilities.json KHÔNG bị code ghi vào — nó là bản duy nhất chứa mật khẩu OTA.

# Session dùng lại bao lâu trước khi login lại (mặc định 30 phút)
OTA_SESSION_TTL_MS=1800000
# Coi session là hết hạn sớm hơn expiresAt bấy nhiêu (mặc định 5 phút)
OTA_SESSION_BUFFER_MS=300000
# Sàn chống dồn dập: vừa login xong trong khoảng này thì dùng lại cookie cũ
OTA_SESSION_MIN_LOGIN_INTERVAL_MS=30000
# Số lần SAI MẬT KHẨU liên tiếp thì khóa tài khoản (0 = tắt khóa).
# Khóa chỉ mở bằng tay, có 3 cách:
#   1. sửa config/sessions.json → sessions["<key>"].locked = false
#   2. sửa lại mật khẩu trong config/facilities.json (khóa tự mở)
#   3. xóa hẳn config/sessions.json để reset mọi session + mọi khóa
OTA_MAX_LOGIN_FAILURES=3

# Circuit breaker cho lỗi HẠ TẦNG (403 Cloudflare, 429, 5xx, timeout).
# Các lỗi này KHÔNG tính vào OTA_MAX_LOGIN_FAILURES, vì IP bị chặn không phải
# lỗi của một tài khoản nào và khóa hết tài khoản chỉ làm admin phải mở tay.
OTA_INFRA_FAILURE_THRESHOLD=5
OTA_CIRCUIT_BACKOFF_MS=600000
OTA_CIRCUIT_BACKOFF_MAX_MS=3600000

# ===== Telegram (kênh admin) =====
# Đang được code dùng nhưng trước đây thiếu trong file này.
# Mọi lỗi đăng nhập đều được gửi (không gộp) để admin theo dõi được; số tin bị
# chặn tự nhiên bởi cơ chế khóa — khóa rồi là không thử login nữa.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Chỉ đặt khi cần route riêng request tới api.telegram.org qua proxy.
# Request tới host Telegram sẽ đi qua proxy này; các call khác vẫn đi trực tiếp.
TELEGRAM_PROXY=http://user:pass@ip_proxy:port
